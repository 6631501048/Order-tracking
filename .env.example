PORT=3000

# ใช้ DATABASE_URL อย่างเดียว (เหมาะกับ deploy) หรือแยก DB_* ก็ได้
# DATABASE_URL=postgres://orders:orders_pass@localhost:5433/orders_db
DB_HOST=localhost
DB_PORT=5433
DB_USER=orders
DB_PASSWORD=orders_pass
DB_NAME=orders_db

# รัน migration ตอน start (docker compose ใช้ค่า true)
RUN_MIGRATIONS=true

# เวลาที่ลูกค้ามีในการจ่ายเงินก่อนออเดอร์ EXPIRED (นาที)
PAYMENT_TTL_MINUTES=15

# ไม่ต้องตั้งก็ได้ถ้ารันด้วย docker compose (ใช้ค่า dev-*-change-me ตาม docker-compose.yml)
# ถ้าจะ deploy จริง ให้ตั้ง token ที่คาดเดายาก — ถ้ารันนอก compose แล้วไม่ตั้ง endpoint ภายในจะตอบ 503
BOT_TOKEN=
ADMIN_TOKEN=
# secret ที่ใช้ตรวจลายเซ็น webhook (X-Signature: sha256=HMAC-SHA256(secret, raw body))
WEBHOOK_SECRET=
BOT_LEASE_SECONDS=120

# เคส 1: retry exponential backoff (30s, 60s, 120s ... ไม่เกิน BOT_MAX_RETRIES ครั้ง แล้วเป็น DELAYED)
BOT_MAX_RETRIES=3
RETRY_BASE_SECONDS=30
RETRY_MAX_DELAY_SECONDS=900

# เคส 5: scheduler (หมดเวลาจ่ายเงิน, ดึง lease คืน, alert คิวค้าง)
QUEUE_SLA_SECONDS=600
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
